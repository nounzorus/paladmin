# ========= Admin panel =========
# Port the panel listens on
PANEL_PORT=8080

# Path to the SQLite database file (created automatically)
PANEL_DB_PATH=./data/paladmin.db

# Admin account created automatically on first boot
# (only if the database has no users yet — REQUIRED, the app refuses to start without it)
PANEL_ADMIN_USERNAME=admin
PANEL_ADMIN_PASSWORD=change-me

# ========= Palworld servers =========
# Palworld servers (host, ports, admin password, RCON) are no longer configured
# via .env: add them from the panel after your first login
# (the "Servers" page, admin-only).

# ========= Metrics history =========
# Interval between polls (ms) and retention period (days)
METRICS_POLL_INTERVAL_MS=60000
METRICS_RETENTION_DAYS=30
